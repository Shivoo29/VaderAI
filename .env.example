# Application Settings
APP_NAME="Vader AI Voice Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-change-this"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL="sqlite:///./vader_ai.db"
# For PostgreSQL: postgresql://user:password@localhost/vader_ai

# OpenAI API (optional - for better AI responses)
OPENAI_API_KEY=""

# Redis (for caching and job queue)
REDIS_URL="redis://localhost:6379/0"

# Audio Settings
SAMPLE_RATE=16000
AUDIO_FORMAT="wav"
MAX_AUDIO_LENGTH_SECONDS=30

# Vader Voice Settings
VADER_VOICE_PITCH=-50
VADER_VOICE_SPEED=0.9
VADER_BREATHING_ENABLED=True

# ESP32 Settings
ESP32_WEBSOCKET_PATH="/ws/esp32"
ESP32_API_KEY="change-this-esp32-api-key"

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_FOLDER="./uploads"

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
